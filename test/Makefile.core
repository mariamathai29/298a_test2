# cocotb unit tests for filter_core, driven directly at its ports (no SPI, no pins)
#
#   make -f Makefile.core                                every test
#   make -f Makefile.core COCOTB_TEST_FILTER=test_reset  one test
#   make -f Makefile.core WAVES=1                        also write $(SIM_BUILD)/filter_core.fst
#
# Kept apart from the end-to-end tests (Makefile): own build folder and
# results file.
#
# ctl_ff uses its behavioural model (AF_BEHAVIORAL_FF): no PDK needed.

SIM ?= icarus
TOPLEVEL_LANG ?= verilog
SRC_DIR = $(CURDIR)/../src

VERILOG_SOURCES = $(SRC_DIR)/filter_core.v $(SRC_DIR)/ctl_ff.v
COMPILE_ARGS   += -DAF_BEHAVIORAL_FF
SIM_BUILD      ?= sim_build/core
COCOTB_RESULTS_FILE ?= results_core.xml

COCOTB_HDL_TIMEUNIT      = 1ns
COCOTB_HDL_TIMEPRECISION = 1ps

COCOTB_TOPLEVEL     = filter_core
COCOTB_TEST_MODULES = test_af_core

include $(shell cocotb-config --makefiles)/Makefile.sim
